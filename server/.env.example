# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/chat_app
USE_IN_MEMORY_DB=auto

# Security & Authentication
JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Email (SMTP) Configuration (optional - console fallback enabled in development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="ChatApp Security" <no-reply@chatapp.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
