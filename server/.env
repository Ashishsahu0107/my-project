# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/chat_app
USE_IN_MEMORY_DB=auto

# Security & Authentication
JWT_SECRET=chat_app_jwt_secret_scalable_production_secure_key_9823471029384
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=chat_app_jwt_refresh_secret_production_key_485720193857
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRY_MINUTES=10

# Email (SMTP) Configuration (optional - console fallback enabled in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ChatApp Security" <no-reply@chatapp.local>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
