{
  "name": "chatapp-monorepo",
  "version": "1.0.0",
  "description": "Expo React Native chat app with Express and MongoDB backend",
  "private": true,
  "scripts": {
    "mobile": "npm --prefix mobile run start",
    "android": "npm --prefix mobile run android",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:export": "npm --prefix mobile run export:android",
    "server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "install:mobile": "npm --prefix mobile install",
    "install:server": "npm --prefix server install",
    "install:all": "npm run install:mobile && npm run install:server"
  }
}
